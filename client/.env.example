# Note: In production with Nginx reverse proxy, all API requests use relative paths
# ("/api" and "/uploads"), so VITE_API_BASE_URL is optional.
# Only specify if the client SPA is hosted on a completely separate domain or CDN.
# VITE_API_BASE_URL=https://api.iskconkopargaon.com

