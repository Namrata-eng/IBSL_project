# ==============================================================================
# ISKCON Kopargaon - Server Environment Configuration
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:ChangeMePassword108@cluster0.abcde.mongodb.net/iskcon_kopargaon?retryWrites=true&w=majority

# JWT Secret for Signing Admin & User Tokens (Use a strong random string)
JWT_SECRET=replace_with_a_secure_random_64_character_secret_string

# Allowed Client Origin(s) for CORS (comma-separated if multiple)
# On AWS EC2 with Nginx on the same domain, specify your live domain(s)
CLIENT_URL=https://iskconkopargaon.com,https://www.iskconkopargaon.com

# External Upload Directory for persistent media files across redeployments
# On AWS EC2 Ubuntu production: /var/www/iskcon-uploads
# In local development: ./uploads
UPLOAD_DIR=/var/www/iskcon-uploads

# DNS Servers (Optional: uncomment only if your network or ISP blocks MongoDB SRV lookups)
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Donation Proof Retention Policy (Days after verification/rejection before screenshot is pruned)
SCREENSHOT_RETENTION_VERIFIED_DAYS=30
SCREENSHOT_RETENTION_REJECTED_DAYS=15

# SMTP Email Configuration for Inquiry & Seva Notifications (Gmail App Password or SMTP Relay)
SMTP_USER=iskconkopargaon@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
ADMIN_EMAIL=iskconkopargaon@gmail.com

